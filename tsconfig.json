{
  "compilerOptions": {
    // Strictness
    "strict": true,
    "exactOptionalPropertyTypes": true,

    // Module
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,

    // Types
    "types": [
      "node",
      "vitest/globals"
    ],

    "typeRoots": [
      "./node_modules",
      "./node_modules/@types"
    ],

    // Others
    "jsx": "preserve",
    "target": "es2015",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "incremental": true,
  },

  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "eslint.config.js",
    "vitest.config.ts"
  ]
}
